# Build a Linux/amd64 Mastra server locally and export its self-contained output.
# This image is a build tool; the ECS service continues to run under systemd.
FROM node:22-bookworm-slim AS build

WORKDIR /app

ARG NPM_REGISTRY=https://registry.npmjs.org
RUN npm config set registry "$NPM_REGISTRY"

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY tsconfig.json ./
COPY src ./src
COPY scripts/migrate.ts ./scripts/migrate.ts
COPY migrations ./migrations
RUN npm run build:mastra \
    && ./node_modules/.bin/esbuild scripts/migrate.ts --bundle --platform=node --format=esm --packages=external --outfile=.mastra/output/migrate.mjs \
    && cp -R migrations .mastra/output/migrations \
    && find .mastra/output -maxdepth 2 -type f \
      \( -name '*.duckdb' -o -name '*.duckdb.wal' -o -name '*.db' -o -name '*.db-wal' -o -name '*.db-shm' \) -delete \
    && test -f .mastra/output/index.mjs \
    && test -f .mastra/output/migrate.mjs \
    && test -d .mastra/output/node_modules

FROM scratch AS artifact
COPY --from=build /app/.mastra/output/ /
