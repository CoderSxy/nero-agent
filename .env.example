TAVILY_API_KEY=

# PostgreSQL connection used for users, sessions and the model catalog.
# DATABASE_URL=

# Base64 encoding of exactly 32 bytes (for example: openssl rand -base64 32).
# Required to encrypt model API keys at rest. Losing it makes saved model keys undecryptable.
MODEL_CONFIG_ENCRYPTION_KEY=

# Comma-separated HTTPS origins approved for model base URLs.
# The one HTTP exception is the exact Base URL http://101.37.135.116:7864/v1.
# For example: https://api.deepseek.com,http://101.37.135.116:7864/v1
# Required; models whose origin (or exact HTTP Base URL) is not listed cannot be saved or called.
MODEL_ENDPOINT_ALLOWLIST=

# Host root for per-user workspaces. Default /data/mastra.
# WORKSPACE_ROOT=/data/mastra
# Set true to give admins a per-user LocalFilesystem (ordinary users stay off until later tasks).
# WORKSPACE_RESOLVER_ENABLED=false
# Set true to expose authenticated /api/user-files and controlled file tools.
# USER_FILES_ENABLED=false
# WORKSPACE_MAX_FILE_SIZE_BYTES=104857600
# Set true to expose the controlled execute_command tool (default off).
# SANDBOX_COMMANDS_ENABLED=false
# SANDBOX_COMMAND_TIMEOUT_MS=120000
